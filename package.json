{
  "name": "keywright",
  "version": "0.0.0",
  "description": "MCP relay for the Keywright Roblox Studio animation plugin",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "keywright": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "test:luau": "node scripts/test-luau.mjs",
    "build:plugin": "rojo build plugin/default.project.json -o build/Keywright.rbxm",
    "build:fault": "rojo build plugin/fault.project.json -o build/KeywrightFault.rbxm",
    "format:check": "stylua --check plugin",
    "measure": "npm run build && node scripts/measure.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
